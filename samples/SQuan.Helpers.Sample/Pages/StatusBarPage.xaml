<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SQuan.Helpers.Sample.StatusBarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sqm="clr-namespace:SQuan.Helpers.Maui;assembly=SQuan.Helpers.Maui"
    Title="Status Bar Demo"
    sqm:StatusBarExtras.StatusBarColor="{AppThemeBinding Light=#e00,
                                                         Dark=#400}"
    sqm:StatusBarExtras.StatusBarStyle="{AppThemeBinding Light=DarkContent,
                                                         Dark=LightContent}">
    <VerticalStackLayout
        Padding="30"
        Spacing="25"
        VerticalOptions="Center">

        <Label HorizontalOptions="Center" Text="This page demonstrates StatusBar color customization for Android/iOS." />

        <Grid Padding="5" BackgroundColor="#e00">
            <Label
                HorizontalTextAlignment="Center"
                Text="In light theme, the StatusBar will be bright-red with black text."
                TextColor="Black" />
        </Grid>

        <Grid Padding="5" BackgroundColor="#400">
            <Label
                HorizontalTextAlignment="Center"
                Text="In light theme, the StatusBar will be dark-red with white text."
                TextColor="White" />
        </Grid>

    </VerticalStackLayout>
</ContentPage>
