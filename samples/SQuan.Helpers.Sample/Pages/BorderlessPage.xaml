<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SQuan.Helpers.Sample.BorderlessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sqm="clr-namespace:SQuan.Helpers.Maui;assembly=SQuan.Helpers.Maui"
    Title="Borderless Demo">
    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#ffe, Dark=#553}" />
        </Style>
        <Style TargetType="Editor">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#ffe, Dark=#553}" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="30">
            <Label Text="Entry" />
            <Entry />

            <Label Text="Entry (borderless)" />
            <Entry>
                <Entry.Behaviors>
                    <sqm:BorderlessBehavior />
                </Entry.Behaviors>
            </Entry>

            <Label Text="Editor" />
            <Editor />

            <Label Text="Editor (borderless)" />
            <Editor>
                <Editor.Behaviors>
                    <sqm:BorderlessBehavior />
                </Editor.Behaviors>
            </Editor>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
