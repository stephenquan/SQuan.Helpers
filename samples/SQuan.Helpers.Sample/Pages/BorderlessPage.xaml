<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SQuan.Helpers.Sample.BorderlessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SQuan.Helpers.Sample"
    xmlns:sqm="clr-namespace:SQuan.Helpers.Maui;assembly=SQuan.Helpers.Maui"
    Title="Borderless Demo"
    x:DataType="local:BorderlessPage">
    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#ffe, Dark=#553}" />
        </Style>
        <Style TargetType="Editor">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#ffe, Dark=#553}" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="30">
            <Label Text="Border Thickness" />

            <HorizontalStackLayout Spacing="10">
                <Button Clicked="OnThicknessClicked" Text="0" />
                <Button Clicked="OnThicknessClicked" Text="1" />
                <Button Clicked="OnThicknessClicked" Text="2" />
                <Button Clicked="OnThicknessClicked" Text="3" />
            </HorizontalStackLayout>

            <Label Text="Entry" />
            <Entry sqm:InputExtras.BorderThickness="{Binding BorderThickness}" />

            <Label Text="Editor" />
            <Editor sqm:InputExtras.BorderThickness="{Binding BorderThickness}" AutoSize="TextChanges" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
