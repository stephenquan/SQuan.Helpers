<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SQuan.Helpers.Sample.NumericMaskPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sqm="clr-namespace:SQuan.Helpers.Maui;assembly=SQuan.Helpers.Maui"
    Title="Numeric Mask Demo">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="30">
            <Label Text="Entry" />
            <Entry />

            <Label Text="Entry (numeric only input)" />
            <Entry Keyboard="Numeric">
                <Entry.Behaviors>
                    <sqm:InputMaskBehavior Keys="0123456789" Regex="^[-]?[\d]*[\.]?[\d]*$" />
                </Entry.Behaviors>
            </Entry>

            <Label Text="Editor" />
            <Editor />

            <Label Text="Editor (numeric only input)" />
            <Editor Keyboard="Numeric">
                <Editor.Behaviors>
                    <sqm:InputMaskBehavior Keys="0123456789" Regex="^[-]?[\d]*[\.]?[\d]*$" />
                </Editor.Behaviors>
            </Editor>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
