<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SQuan.Helpers.Sample.LocalizePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:i18n="clr-namespace:SQuan.Helpers.Maui.Localization;assembly=SQuan.Helpers.Maui.Localization"
    xmlns:local="clr-namespace:SQuan.Helpers.Sample"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="{i18n:Localize 'PAG_LOCALIZE_DEMO'}"
    x:DataType="local:LocalizePage">

    <ScrollView>
        <VerticalStackLayout Padding="30,30,30,200" Spacing="25">
            <Grid
                HeightRequest="185"
                HorizontalOptions="Start"
                WidthRequest="480">
                <Image
                    x:Name="DotNetBotImage"
                    Aspect="AspectFit"
                    HorizontalOptions="Start"
                    SemanticProperties.Description="dot net bot in a hovercraft number nine"
                    Source="dotnet_bot.png" />

                <Button Clicked="OnAspect" Opacity="0.2" />
            </Grid>

            <Label
                HorizontalOptions="Start"
                Text="{i18n:Localize X0={Binding Aspect,
                                                 x:DataType=Image,
                                                 Source={Reference DotNetBotImage}},
                                     Converter={x:Static local:LocalizePage.AspectToTextConverter}}"
                VerticalOptions="Start" />

            <!--
            <Label
                x:Name="HelloLabel"
                HorizontalOptions="Start"
                HorizontalTextAlignment="Start"
                SemanticProperties.HeadingLevel="Level1"
                Style="{StaticResource Headline}"
                Text="{i18n:Localize LBL_HELLO}" />
            -->

            <Label
                x:Name="HelloLabel"
                HorizontalOptions="Start"
                HorizontalTextAlignment="Start"
                SemanticProperties.HeadingLevel="Level1"
                Style="{StaticResource Headline}" />

            <Label
                HorizontalOptions="Start"
                HorizontalTextAlignment="Start"
                SemanticProperties.Description="Welcome to dot net Multi platform App U I"
                SemanticProperties.HeadingLevel="Level2"
                Style="{StaticResource SubHeadline}"
                Text="{i18n:Localize LBL_WELCOME}" />

            <Button
                x:Name="CounterBtn"
                Command="{Binding IncrementCounterCommand}"
                HorizontalOptions="Start"
                Text="{i18n:Localize BTN_CLICKED_N_TIMES,
                                     X0={Binding Count}}" />

            <Button
                Command="{Binding ToggleAppCultureCommand}"
                Text="{Binding CurrentUICulture.Name, x:DataType='i18n:LocalizationManager', Source={x:Static i18n:LocalizationManager.Current}}"
                ZIndex="0" />

            <Border Padding="10">
                <VerticalStackLayout i18n:LocalizeGroup.CurrentUICulture="{Binding ScopedUICulture}" Spacing="25">
                    <Label
                        HorizontalOptions="Start"
                        HorizontalTextAlignment="Start"
                        SemanticProperties.HeadingLevel="Level1"
                        Style="{StaticResource Headline}"
                        Text="{i18n:Localize LBL_HELLO}" />

                    <Label
                        HorizontalOptions="Start"
                        HorizontalTextAlignment="Start"
                        SemanticProperties.Description="Welcome to dot net Multi platform App U I"
                        SemanticProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubHeadline}"
                        Text="{i18n:Localize LBL_WELCOME}" />

                    <Button
                        Command="{Binding IncrementCounterCommand}"
                        HorizontalOptions="Start"
                        Text="{i18n:Localize BTN_CLICKED_N_TIMES,
                                             X0={Binding Count}}" />

                    <Button
                        Command="{Binding ToggleScopedCultureCommand}"
                        Text="{Binding ScopedUICulture.Name}"
                        ZIndex="0" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="10">
                <VerticalStackLayout i18n:LocalizeGroup.CurrentUICulture="{Binding FormUICulture}" Spacing="25">

                    <Label Text="{i18n:Localize '/survey/x1:label'}" />
                    <Entry Text="{Binding FormContext.EM[/survey/x1], Mode=TwoWay}" />

                    <Label Text="{i18n:Localize '/survey/x2:label'}" />
                    <Entry Text="{Binding FormContext.EM[/survey/x2], Mode=TwoWay}" />

                    <Label Text="{i18n:Localize '/survey/sum:label'}" />
                    <Entry Text="{Binding FormContext.EM[/survey/sum], Mode=OneWay}" />

                    <Label Text="{i18n:Localize '/survey/product:label'}" />
                    <Entry Text="{Binding FormContext.EM[/survey/product], Mode=OneWay}" />

                    <Button
                        Command="{Binding ToggleFormCultureCommand}"
                        Text="{Binding FormUICulture.Name}"
                        ZIndex="0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
